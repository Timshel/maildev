{
  "name": "@timshel_npm/maildev",
  "description": "SMTP Server with async API and Web Interface for viewing and testing emails during development",
  "version": "3.3.7",
  "keywords": [
    "email",
    "e-mail",
    "mail",
    "maildev",
    "mailcatcher",
    "testing",
    "development",
    "smtp",
    "async",
    "playwright"
  ],
  "author": "Timshel",
  "homepage": "https://github.com/Timshel/maildev",
  "maintainers": [
    {
      "name": "Timshel",
      "email": "timshel@users.noreply.github.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Timshel/maildev"
  },
  "scripts": {
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "build": "tsc --build && npm run copy-app",
    "copy-app": "mkdir -p dist && cp -r ./src/app ./dist",
    "start": "npm run build && node ./bin/maildev",
    "test": "prettier . -c && npm run build && nyc mocha --exit --timeout 5000",
    "test:debug": "npm run build && nyc mocha --exit --timeout 5000",
    "test:only": "nyc mocha --exit --timeout 5000",
    "lint": "prettier . -c",
    "lint:fix": "prettier . -w",
    "dev": "node ./scripts/dev.js",
    "docker-build": "./src/scripts/dockerBuild.sh",
    "docker-run": "docker run --rm -p 1080:1080 -p 1025:1025 maildev/maildev:$npm_package_version",
    "docker-push": "./src/scripts/dockerPush.sh",
    "update-readme": "node ./src/scripts/updateUsageREADME.js",
    "prepare": "npm run build"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "maildev": "./bin/maildev"
  },
  "license": "MIT",
  "dependencies": {
    "@types/mailparser": "3.9.0",
    "addressparser": "1.0.1",
    "async": "3.2.6",
    "commander": "15.0.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "jsdom": "30.1.3",
    "mailparser": "3.10.0",
    "mime": "4.1.1",
    "nodemailer": "10.1.7",
    "smtp-server": "3.20.2",
    "socket.io": "4.8.4",
    "wildstring": "1.0.9"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "engine.io": "6.6.11",
    "serialize-javascript": "7.1.2",
    "source-map-js": "1.2.2",
    "uuid": "14.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.13.14",
    "expect": "30.5.2",
    "http-proxy-middleware": "4.2.0",
    "jest": "30.5.2",
    "jest-mock": "30.5.2",
    "mocha": "12.0.3",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "nyc": {
    "exclude": [
      "test/**/*",
      "src/lib/helpers/strtotime.js"
    ],
    "ignore-class-method": "methodToIgnore",
    "reporter": [
      "json",
      "lcov",
      "text-summary"
    ]
  },
  "prettier": {
    "printWidth": 100
  }
}


