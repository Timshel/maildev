{
  "name": "@timshel_npm/maildev",
  "description": "SMTP Server with async API and Web Interface for viewing and testing emails during development",
  "version": "3.3.3",
  "keywords": [
    "email",
    "e-mail",
    "mail",
    "maildev",
    "mailcatcher",
    "testing",
    "development",
    "smtp",
    "async",
    "playwright"
  ],
  "author": "Timshel",
  "homepage": "https://github.com/Timshel/maildev",
  "maintainers": [
    {
      "name": "Timshel",
      "email": "timshel@users.noreply.github.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Timshel/maildev"
  },
  "scripts": {
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "build": "tsc --build && npm run copy-app",
    "copy-app": "mkdir -p dist && cp -r ./src/app ./dist",
    "start": "npm run build && node ./bin/maildev",
    "test": "prettier . -c && npm run build && nyc _mocha --exit --timeout 5000",
    "test:debug": "npm run build && nyc _mocha --exit --timeout 5000",
    "test:only": "nyc _mocha --exit --timeout 5000",
    "lint": "prettier . -c",
    "lint:fix": "prettier . -w",
    "dev": "node ./scripts/dev.js",
    "docker-build": "./src/scripts/dockerBuild.sh",
    "docker-run": "docker run --rm -p 1080:1080 -p 1025:1025 maildev/maildev:$npm_package_version",
    "docker-push": "./src/scripts/dockerPush.sh",
    "update-readme": "node ./src/scripts/updateUsageREADME.js",
    "prepare": "npm run build"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "maildev": "./bin/maildev"
  },
  "license": "MIT",
  "dependencies": {
    "addressparser": "1.0.1",
    "async": "3.2.6",
    "commander": "15.0.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dompurify": "3.4.12",
    "express": "5.2.1",
    "jsdom": "29.1.1",
    "postal-mime": "2.7.5",
    "mime": "4.1.0",
    "nodemailer": "9.0.3",
    "smtp-server": "3.19.2",
    "socket.io": "4.8.3",
    "wildstring": "1.0.9"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "body-parser": "2.3.0",
    "diff": "8.0.4",
    "engine.io": "6.6.9",
    "js-yaml": "5.2.1",
    "serialize-javascript": "7.0.7",
    "uuid": "14.0.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.39",
    "expect": "30.4.1",
    "http-proxy-middleware": "4.2.0",
    "jest": "30.4.2",
    "jest-mock": "30.4.1",
    "mocha": "11.7.6",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "nyc": {
    "exclude": [
      "test/**/*",
      "src/lib/helpers/strtotime.js"
    ],
    "ignore-class-method": "methodToIgnore",
    "reporter": [
      "json",
      "lcov",
      "text-summary"
    ]
  },
  "prettier": {
    "printWidth": 100
  }
}
